{
    "spec":  {
                 "containers":  [
                                    {
                                        "image":  "ledger-api:ticket010-alpine",
                                        "name":  "ledger-api",
                                        "ports":  [
                                                      {
                                                          "containerPort":  8080
                                                      }
                                                  ],
                                        "resources":  {
                                                          "limits":  {
                                                                         "cpu":  "250m",
                                                                         "memory":  "128Mi"
                                                                     },
                                                          "requests":  {
                                                                           "cpu":  "100m",
                                                                           "memory":  "64Mi"
                                                                       }
                                                      },
                                        "securityContext":  {
                                                                "allowPrivilegeEscalation":  false,
                                                                "capabilities":  {
                                                                                     "drop":  [
