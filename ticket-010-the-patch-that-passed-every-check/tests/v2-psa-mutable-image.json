                                                                                              ]
                                                                                 },
                                                                "privileged":  false,
                                                                "readOnlyRootFilesystem":  true,
                                                                "runAsGroup":  10001,
                                                                "runAsNonRoot":  true,
                                                                "runAsUser":  10001,
                                                                "seccompProfile":  {
                                                                                       "type":  "RuntimeDefault"
                                                                                   }
                                                            }
                                    }
                                ],
                 "securityContext":  {
                                         "runAsGroup":  10001,
                                         "runAsNonRoot":  true,
                                         "runAsUser":  10001,
                                         "seccompProfile":  {
                                                                "type":  "RuntimeDefault"
                                                            }
                                     }
             },
    "metadata":  {
                     "labels":  {
                                    "app":  "ledger-api"
                                },
                     "name":  "ticket010-psa-mutable-image",
                     "namespace":  "ticket-010-lab"
                 },
    "apiVersion":  "v1",
    "kind":  "Pod"
